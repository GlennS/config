// The home kanshi profile starts waybar with this file, and the laptop profile
// uses laptop.jsonc. Other kanshi profiles use config.jsonc, which shows the
// full bar on all outputs.
[
    // The full bar, only on the middle monitor.
    {
        "include": "~/.config/waybar/config.jsonc",
        "output": "Dell Inc. DELL P2723QE 8DFK7L3",
        // The same modules as in config.jsonc, but the webcam covers the middle
        // of the bar, so some modules move to the left side. With more than
        // three workspaces on this monitor, they move under the webcam again.
        "modules-left": [
            "sway/workspaces",
            "sway/mode",
            "network#ethernet",
            "cpu",
            "battery"
        ],
        "modules-right": ["network#wifi", "clock", "tray"]
    },
    // The other monitors show only their own workspaces.
    // The laptop panel has no serial number. Sway and kanshi put "Unknown" in
    // its place, but waybar leaves the serial out.
    {
        "output": ["Dell Inc. DELL U2415 5K39C69N152L", "Sharp Corporation 0x14AE"],
        "position": "top",
        "modules-left": ["sway/workspaces", "sway/mode"],
        "modules-right": []
    }
]
