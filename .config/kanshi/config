profile home {
  output "Dell Inc. DELL U2415 5K39C69N152L" mode 1920x1200 position 0,0 scale 1.5
  output "Dell Inc. DELL P2723QE 8DFK7L3" mode 3840x2160 position 1280,0 scale 2
  output "Sharp Corporation 0x14AE Unknown" mode 1920x1080 position 3200,463 scale 1.75
  # kanshi, not sway, starts waybar, so that the bar output follows the profile.
  exec pkill -x waybar; waybar -c ~/.config/waybar/home.jsonc
}

profile laptop {
  output "Sharp Corporation 0x14AE Unknown" mode 1920x1080 position 0,0 scale 1.75
  exec pkill -x waybar; waybar -c ~/.config/waybar/laptop.jsonc
}

# Tash's office, with two Dell monitors on a DisplayLink dock. The sway lid bindings turn the panel
# off when the lid is closed, so this profile also covers that case.
profile tash-office {
  output "Sharp Corporation 0x14AE Unknown" mode 1920x1080 position 0,463 scale 1.75
  # Without the rate, kanshi can pick the 75 Hz mode of the S2421HS.
  output "Dell Inc. DELL S2421HS 8FPP9H3" mode 1920x1080@60Hz position 1097,0
  output "Dell Inc. DELL S2319H 71P7K93M038T" mode 1920x1080@60Hz position 3017,0
  exec pkill -x waybar; waybar -c ~/.config/waybar/tash-office.jsonc
}

# The fallback profiles below must stay last, because kanshi uses the first profile that matches.
# They leave the position and mode of each monitor to sway, and show the full bar on all of them.

# Unknown monitors with the laptop panel.
profile fallback-with-laptop {
  output "Sharp Corporation 0x14AE Unknown" scale 1.75
  ...output *
  exec pkill -x waybar; waybar -c ~/.config/waybar/config.jsonc
}

# Unknown monitors without the laptop panel. The panel stays connected when the lid closes,
# so a closed lid does not select this profile.
profile fallback {
  ...output *
  exec pkill -x waybar; waybar -c ~/.config/waybar/config.jsonc
}
