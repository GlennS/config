export KRAKEN_DB_CONCURRENCY=1

alias tst="inv localdev.pytest"
alias tstchanged="pre-commit run pytest --from-ref=origin/master --to-ref=HEAD"

# Per-directory node versions come from direnv (`use node` in .envrc), so nvm
# itself is only needed to install them. Sourcing nvm.sh costs ~0.17s, so defer
# it until something actually calls nvm.
export NVM_DIR="$HOME/.nvm"
nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    nvm "$@"
}
